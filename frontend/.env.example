# Copy to .env to point the app at the Django backend instead of the mock.
# (Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app.)

EXPO_PUBLIC_USE_MOCK=false
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api

# On a physical device, replace localhost with your machine's LAN IP, e.g.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:8000/api
